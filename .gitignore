# ========================================
# Episode-specific content
# ========================================
# Excluded to keep the repo as a reusable studio template.
# Everything tied to a specific video slug lives here.

# Raw recordings
raw-videos/*
!raw-videos/.gitkeep

# Research transcripts & cache
research/transcripts/*
!research/transcripts/.gitkeep
research/references/*
!research/references/.gitkeep

# Scripts (episode-specific)
scripts/long-form/*
!scripts/long-form/.gitkeep
scripts/short-form/*
!scripts/short-form/.gitkeep

# Animation specs (keep template only)
animations/specs/*
!animations/specs/_template.spec.md
!animations/specs/.gitkeep

# Episode compositions
animations/remotion-app/src/compositions/*
!animations/remotion-app/src/compositions/.gitkeep

# Renders
animations/renders/*
!animations/renders/.gitkeep

# Episode assets
assets/images/*
!assets/images/.gitkeep
assets/videos/*
!assets/videos/.gitkeep
assets/audio/*
!assets/audio/.gitkeep
assets/logos/*
!assets/logos/.gitkeep

# ========================================
# Studio config (per-clone, generated by /project-setup wizard)
# ========================================
.claude/studio-config.yaml

# ========================================
# Dependencies & build artifacts
# ========================================
node_modules/
.venv/
__pycache__/
*.pyc
.cache/
dist/
out/

# Cached Gemini analysis results (paid; third-party content)
*.gemini.json

# ========================================
# Materialized studio files (per-project, generated by /project-setup)
# ========================================
# The committed source of truth lives in .claude/templates/. These runtime
# copies are materialized by scripts/materialize.py and owned by each project
# (the user edits them freely as their project evolves). Anchored to the repo
# root so the templates under .claude/templates/ stay tracked.
/scripts/CONTEXT.md
/research/CONTEXT.md
/assets/CONTEXT.md
/animations/CONTEXT.md
/animations/design-system/CONTEXT.md
/animations/design-system/palette.md
/animations/design-system/typography.md
/animations/design-system/motion.md
/animations/design-system/components.md
!/animations/design-system/.gitkeep
/animations/remotion-app/src/_shared/theme.ts
/animations/remotion-app/src/style.css

# ========================================
# OS & editor
# ========================================
.DS_Store
.env
